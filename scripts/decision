#!/usr/bin/env bash
# Print entries of docs/decisions/ without reading the whole file. Each entry
# is its own file, docs/decisions/Dnnn.md, plus a policy header in
# docs/decisions/policy.md.
#
#   scripts/decision              list every entry: number, title, status
#   scripts/decision D052 D050    print those entries in full
set -euo pipefail

DIR="$(git rev-parse --show-toplevel)/docs/decisions"

if [ $# = 0 ]; then
  mapfile -t entries < <(ls "$DIR"/D*.md | sort)
  awk '/^## D[0-9]+:/ { if (h) print h; h = substr($0, 4); next }
       h && /^Status:/ { print h "  [" substr($0, 9) "]"; h = "" }
       END { if (h) print h }' "${entries[@]}"
  exit 0
fi

for id in "$@"; do
  [[ "$id" =~ ^D[0-9]+$ ]] || { echo "decision: not a decision number: $id" >&2; exit 2; }
  [ -s "$DIR/$id.md" ] || { echo "decision: no entry $id" >&2; exit 1; }
  out=$(awk -v id="$id" '/^## D[0-9]+:/ { on = ($2 == id ":") } on' "$DIR/$id.md")
  [ -n "$out" ] || { echo "decision: no entry $id" >&2; exit 1; }
  printf '%s\n\n' "$out"
done
